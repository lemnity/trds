{
  "name": "trds",
  "version": "0.1.0",
  "private": true,
  "description": "Сайт и билетная система театра «Турдус»",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "certificates:issue": "NODE_OPTIONS=--no-deprecation payload run src/bin/issue-certificates.ts",
    "cms:seed": "PAYLOAD_MIGRATING=true NODE_OPTIONS=--no-deprecation payload run src/bin/cms-seed.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "drill:schema": "NODE_OPTIONS=--no-deprecation payload run scripts/drill/push-schema.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "graphql": "16.8.1",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "payload": "3.90.2",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "payload>undici": "7.30.1",
      "monaco-editor>dompurify": "3.4.17"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-67mh-4wv8-2f99",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
