# Только имена переменных и безопасные значения по умолчанию — без реальных секретов.
# Полный список будущих переменных: architecture.md §15.

# --- Общие ---
# Минимум 32 символа. Генерация: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Локальная разработка (pnpm dev) ---
# БД в контейнере trds-pg (см. README.md).
DATABASE_URL=postgres://trds:CHANGE_ME@127.0.0.1:5436/trds

# Разработка без базы: коды входа и сессии в памяти (только NODE_ENV=development).
# ACCOUNTS_STORE=memory
# Счётчики ограничения частоты запросов: при DATABASE_URL — общие в PostgreSQL (ops_rate_limits),
# иначе в памяти процесса. memory — принудительно память (только вне production).
# RATE_LIMIT_STORE=memory

# --- Вход через Яндекс ID (T-056) ---
# Приложение регистрирует театр на своём аккаунте: https://oauth.yandex.ru/client/new
# Платформа «Веб-сервисы», права «Доступ к адресу электронной почты» (login:email) и
# «Доступ к логину, имени и фамилии, полу» (login:info). Redirect URI — ровно
# https://<домен>/api/auth/yandex/callback (в production только https).
# Пусто хотя бы одно — вход через Яндекс выключен, кнопки на сайте нет.
# YANDEX_CLIENT_SECRET — только на сервере (не NEXT_PUBLIC_*).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

# --- Оплата (T-043…T-045) ---
# Провайдер оплаты. Пусто — оплата на сайте не подключена (checkout честно говорит об этом).
# fake — учебный банк для разработки (страница /api/payments/fake/bank); в production запрещён.
# Адаптер настоящего банка появится после выбора банка (T-001).
# PAYMENT_PROVIDER=fake
# Только dev: короткая бронь (секунды) для проверки поздней оплаты на учебном банке.
# CHECKOUT_HOLD_TTL_SECONDS=60
# Адрес сайта для возврата из банка (в production обязателен — не доверяем заголовку Host).
# NEXT_PUBLIC_SITE_URL=https://teatrturdus.ru

# --- docker compose (app, worker, postgres, caddy) ---
# Генерация: openssl rand -hex 16
POSTGRES_PASSWORD=
# Домен сайта; для локальной проверки — localhost (самоподписанный сертификат Caddy).
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# 0 — для localhost, чтобы браузер не запоминал HSTS. В production не задавать (по умолчанию 1 год).
HSTS_MAX_AGE=0
# Период фоновых задач worker, мс (по умолчанию 5 минут).
WORKER_TICK_MS=300000

# --- Логи и мониторинг (T-015, docs/runbook.md) ---
# debug | info | warn | error (по умолчанию info).
LOG_LEVEL=info
# Файлы состояния для /api/health. В compose заданы сами (том ops-state); в pnpm dev не нужны.
# WORKER_HEARTBEAT_FILE=/app/state/worker-heartbeat.json
# BACKUP_STATUS_FILE=/app/state/backup-status.json
# Через сколько heartbeat считается устаревшим, мс (по умолчанию 15 минут = 3 такта).
# WORKER_HEARTBEAT_MAX_AGE_MS=900000
# Сколько часов без успешного бэкапа допустимо (по умолчанию 26).
# BACKUP_MAX_AGE_HOURS=26

# --- Резервные копии (T-014, scripts/backup.sh) ---
# Время ежедневного запуска по UTC (00:30 UTC = 03:30 МСК) и срок хранения в днях.
BACKUP_AT=00:30
BACKUP_RETENTION_DAYS=14
# Внешняя копия (S3 в РФ) — ЗАГЛУШКА: провайдер не выбран, значение только логируется.
# BACKUP_OFFSITE_TARGET=s3://<bucket>/<prefix>

# --- Аналитика ---
# Номер счётчика Яндекс Метрики (только цифры). Пусто — счётчика нет. Загружается только после согласия в баннере cookie.
NEXT_PUBLIC_YM_ID=

# --- Почта и письма с билетами (T-047, src/modules/email) ---
# smtp — SMTP провайдера (NotiSend / Unisender Go / иной; выбор театра открыт). Пусто: в pnpm dev —
# локальный ящик /api/dev/outbox, в production отправки нет (письма ждут в outbox, worker их не берёт).
EMAIL_PROVIDER=
SMTP_HOST=
# 587 + STARTTLS (обязателен, кроме localhost) или 465 + SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Отправитель, например: Модный театр TURDUS <tickets@teatrturdus.ru> (домен с SPF/DKIM у провайдера).
EMAIL_FROM=
EMAIL_REPLY_TO=
# Куда слать «заказ требует проверки» (поздняя оплата без мест и т.п.). Пусто — такие письма ждут в очереди.
THEATRE_NOTIFY_EMAIL=
# Адрес сайта для ссылок в письмах (QR, кабинет); по умолчанию NEXT_PUBLIC_SITE_URL.
PUBLIC_SITE_URL=

# --- CMS (T-021…T-026) ---
# Источник данных сайта: пусто/auto — CMS при наличии DATABASE_URL (вне production пустая или
# недоступная CMS → демо-набор), cms — строго CMS, demo — всегда демо-набор.
# CONTENT_SOURCE=
# Системные администраторы CMS (через запятую): назначают администраторов, сбрасывают чужую MFA.
# Первый созданный сотрудник становится системным администратором автоматически.
# CMS_SYSTEM_ADMIN_EMAILS=
# Папка загрузок «Медиа» до подключения S3 (по умолчанию ./media).
# MEDIA_DIR=
