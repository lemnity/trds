# Только имена переменных и безопасные значения по умолчанию — без реальных секретов.
# Полный список будущих переменных: architecture.md §15.

# --- Общие ---
# Минимум 32 символа. Генерация: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Локальная разработка (pnpm dev) ---
# БД в контейнере trds-pg (см. README.md).
DATABASE_URL=postgres://trds:CHANGE_ME@127.0.0.1:5436/trds

# Разработка без базы: коды входа и сессии в памяти (только NODE_ENV=development).
# ACCOUNTS_STORE=memory

# --- docker compose (app, worker, postgres, caddy) ---
# Генерация: openssl rand -hex 16
POSTGRES_PASSWORD=
# Домен сайта; для локальной проверки — localhost (самоподписанный сертификат Caddy).
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# 0 — для localhost, чтобы браузер не запоминал HSTS. В production не задавать (по умолчанию 1 год).
HSTS_MAX_AGE=0
# Период фоновых задач worker, мс (по умолчанию 5 минут).
WORKER_TICK_MS=300000

# --- Логи и мониторинг (T-015, docs/runbook.md) ---
# debug | info | warn | error (по умолчанию info).
LOG_LEVEL=info
# Файлы состояния для /api/health. В compose заданы сами (том ops-state); в pnpm dev не нужны.
# WORKER_HEARTBEAT_FILE=/app/state/worker-heartbeat.json
# BACKUP_STATUS_FILE=/app/state/backup-status.json
# Через сколько heartbeat считается устаревшим, мс (по умолчанию 15 минут = 3 такта).
# WORKER_HEARTBEAT_MAX_AGE_MS=900000
# Сколько часов без успешного бэкапа допустимо (по умолчанию 26).
# BACKUP_MAX_AGE_HOURS=26

# --- Резервные копии (T-014, scripts/backup.sh) ---
# Время ежедневного запуска по UTC (00:30 UTC = 03:30 МСК) и срок хранения в днях.
BACKUP_AT=00:30
BACKUP_RETENTION_DAYS=14
# Внешняя копия (S3 в РФ) — ЗАГЛУШКА: провайдер не выбран, значение только логируется.
# BACKUP_OFFSITE_TARGET=s3://<bucket>/<prefix>

# --- Аналитика ---
# Номер счётчика Яндекс Метрики (только цифры). Пусто — счётчика нет. Загружается только после согласия в баннере cookie.
NEXT_PUBLIC_YM_ID=
