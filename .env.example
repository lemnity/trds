# Только имена переменных и безопасные значения по умолчанию — без реальных секретов.
# Полный список будущих переменных: architecture.md §15.

# --- Общие ---
# Генерация: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Локальная разработка (pnpm dev) ---
# БД в контейнере trds-pg (см. README.md).
DATABASE_URL=postgres://trds:CHANGE_ME@127.0.0.1:5436/trds

# --- docker compose (app, worker, postgres, caddy) ---
# Генерация: openssl rand -hex 16
POSTGRES_PASSWORD=
# Домен сайта; для локальной проверки — localhost (самоподписанный сертификат Caddy).
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# 0 — для localhost, чтобы браузер не запоминал HSTS. В production не задавать (по умолчанию 1 год).
HSTS_MAX_AGE=0
# Период фоновых задач worker, мс (по умолчанию 5 минут).
WORKER_TICK_MS=300000
