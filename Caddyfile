# TLS выпускается автоматически для {$SITE_DOMAIN}; для localhost — локальный CA Caddy.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Верхняя граница тела запроса (загрузка медиа в админке). Лимиты API/webhook — в приложении.
	request_body {
		max_size 25MB
	}

	reverse_proxy app:3000
}
